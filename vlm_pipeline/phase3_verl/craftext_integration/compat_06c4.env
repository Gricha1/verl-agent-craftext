# Effective training settings copied from Comet experiment
# 06c4a9b668434b24a2caa4ab9da8b8e6.  This file intentionally contains no
# credentials and is sourced only by the isolated compatibility run.
NUM_ENVS=32
TOTAL_EPOCHS=8000
VLLM_MAX_BATCHED_TOKENS=8192
MAX_PROMPT_LENGTH=3072
MAX_RESPONSE_LENGTH=320
TRAIN_BATCH_SIZE=32
VAL_BATCH_SIZE=16
PPO_MINI_BATCH_SIZE=64
PPO_MICRO_BATCH_SIZE=16
VAL_BEFORE_TRAIN=true
TEST_FREQ=20
SAVE_FREQ=5
VALIDATION_SEED=0
VALIDATION_TRAJECTORY_LIMIT=16
LOGGER_BACKENDS='[console,comet,file,tensorboard]'

DATA_RETURN_RAW_CHAT=false
DATA_FILTER_OVERLONG_PROMPTS=true
DATA_TRUNCATION=error
LORA_RANK=64
LORA_ALPHA=64
USE_REMOVE_PADDING=false
USE_TORCH_COMPILE=false
USE_KL_LOSS=true
KL_LOSS_COEF=0.01
ENTROPY_COEFF=0.01
ROLLOUT_MODE=sync
ROLLOUT_MAX_MODEL_LEN=null
ROLLOUT_MAX_NUM_SEQS=1024
# The legacy run used 0.14 while retaining its engine allocation across PPO
# updates.  The modern launcher below releases the engine between phases, so
# use a larger KV-cache budget during rollouts only.
ROLLOUT_GPU_MEMORY_UTILIZATION=0.50
ROLLOUT_FREE_CACHE_ENGINE=true
ROLLOUT_LOGPROB_MICRO_BATCH_SIZE=8
REF_LOGPROB_MICRO_BATCH_SIZE=8
# `dummy_dtensor` was the legacy veRL spelling; current veRL's equivalent is
# `dummy` (it has no effect on model weights or PPO dynamics).
ROLLOUT_LOAD_FORMAT=dummy
ROLLOUT_CHAT_FORMAT=chatml
VAL_DO_SAMPLE=true
VAL_TEMPERATURE=1.0

CRAF_TEXT_ENV_CONFIG=debug_square_16x16
CRAF_TEXT_RESET_RATIO=8
CRAF_TEXT_SEED=0
CRAF_TEXT_ACTION_HISTORY_LENGTH=50
CRAF_TEXT_REASONING_HISTORY_LENGTH=3
CRAF_TEXT_REWARD_MODE=remaining_return
CRAF_TEXT_REMAINING_RETURN_GAMMA=0.99
CRAF_TEXT_USE_INVALID_ACTION_PENALTY=true
CRAF_TEXT_INVALID_ACTION_PENALTY_COEF=0.1
