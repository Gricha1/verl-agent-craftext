# Runtime of the modern veRL CrafText runs without baking code into the image: the launchers mount the one checkout and put
# vlm_pipeline/phase3_verl first on PYTHONPATH (safe_rl_nlp.md 14.20). Same dependency set as Dockerfile.smoke, plus stock
# Crafter (all-achievements Stage 2 plays the ZeroHero protocol on crafter.Env) and the Dreamer 4 extras of the
# Stage-2 dreamer_service (einops, lpips are imported by the dreamer4 package).
#   docker build -f Dockerfile.deps -t modern-verl-craftext:deps-<commit> vlm_pipeline/phase3_verl/craftext_integration
FROM vllm/vllm-openai:v0.24.0

COPY wheels/ /tmp/wheels/
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
      'ray[default] @ file:///tmp/wheels/ray-2.55.1-cp312-cp312-manylinux2014_x86_64.whl' hydra-core omegaconf \
      'tensordict==0.10.0' accelerate \
      datasets dill pandas peft pyarrow torchdata packaging wandb tensorboard comet_ml \
      'trl==0.27.0' \
      fastapi uvicorn codetiming qwen_vl_utils mathruler nvtx torchcodec \
      pylatexenc cachetools 'transformers==5.9.0' && \
    python3 -m pip install --no-cache-dir \
      'jax==0.4.30' /tmp/wheels/jaxlib-0.4.30-cp312-cp312-manylinux2014_x86_64.whl \
      'chex==0.1.86' 'distrax==0.1.5' \
      'flax==0.8.5' 'gym==0.26.2' 'gymnax==0.0.6' 'optax==0.2.1'
RUN python3 -m pip install --no-cache-dir \
      'https://github.com/Ascend/TransferQueue/archive/1195ec1c0f10795c371754f28ff6997aa54a6a53.zip'
RUN python3 -m pip install --no-cache-dir \
      'pybind11>=2.12.0' gymnasium imageio matplotlib pygame crafter einops lpips && \
    python3 -c "import jax, ray, torch, transfer_queue, vllm, crafter, einops"
