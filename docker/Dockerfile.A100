FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=America/San_Francisco
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
ENV CRAFTAX_RELOAD_TEXTURES=True

RUN apt-get update && apt-get install -y \
  ffmpeg git python3-pip vim libglew-dev \
  x11-xserver-utils xvfb curl pkg-config \
  libhdf5-dev libfreetype6-dev zip \
  libsdl1.2-dev libsdl-image1.2-dev libsdl-ttf2.0-dev \
  libsdl-mixer1.2-dev libportmidi-dev \
  && apt-get clean

RUN apt install -y python3-dev libsdl2-dev libsdl2-image-dev libsdl2-mixer-dev libsdl2-ttf-dev

# Install conda & setup conda
RUN curl -L -o ~/miniconda.sh -O https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
  && chmod +x ~/miniconda.sh \
  && ~/miniconda.sh -b -p /opt/conda \
  && rm ~/miniconda.sh
RUN /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
RUN /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
RUN /opt/conda/bin/conda install -y numpy scipy ipython mkl mkl-include \
  && /opt/conda/bin/conda clean -ya
ENV PATH=/opt/conda/bin:$PATH

RUN conda create -n verl-agent-311 python==3.11 -y

SHELL ["conda", "run", "-n", "verl-agent-311", "/bin/bash", "-c"]
RUN echo "Current conda environment:" && conda info --envs | grep '*' || echo "No environment activated!"

# Activate conda when container starts (runtime deps: verl + vllm from mounted workspace)
SHELL ["/bin/bash", "--login", "-c"]
RUN echo ". /opt/conda/etc/profile.d/conda.sh" >> ~/.bashrc \
  && echo "conda activate verl-agent-311" >> ~/.bashrc \
  && echo "export CRAFTAX_RELOAD_TEXTURES=True" >> ~/.bashrc \
  && echo "cd /usr/home/workspace && pip install -e . 'vllm==0.8.5'" >> ~/.bashrc

SHELL ["conda", "run", "-n", "verl-agent-311", "/bin/bash", "-c"]
RUN pip install torch==2.5.1+cu118 torchvision --index-url https://download.pytorch.org/whl/cu118
RUN pip install "alfworld==0.4.2" termcolor tqdm "textworld[pddl]>=1.6.1"
# flash-attn needs a torch/CUDA-matched wheel; final install is done at runtime in entrypoint
# after workspace deps upgrade torch (see entrypoint.sh).

WORKDIR /usr/home/workspace

# No COPY of repo sources: mount host repo at /usr/home/workspace (see docker/start.sh).
# Heavy deps install runs once via docker/entrypoint.sh → setup_caged_craftext_deps.sh
# (marker: .docker_caged_deps_installed on the volume).
COPY docker/entrypoint.sh /usr/local/bin/entrypoint-caged-craftext.sh
RUN chmod +x /usr/local/bin/entrypoint-caged-craftext.sh
ENTRYPOINT ["/usr/local/bin/entrypoint-caged-craftext.sh"]
CMD ["bash", "--login"]
